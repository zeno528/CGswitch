{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node scripts/hook-checks.mjs",
            "timeout": 30,
            "statusMessage": "跑样式与 i18n 护栏"
          }
        ]
      }
    ]
  }
}
