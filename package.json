{
  "name": "cgswitch",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "dev": "pnpm sync-version && vite",
    "dev:tauri": "pnpm sync-version && tauri dev",
    "build": "pnpm sync-version && vite build",
    "build:debug": "pnpm sync-version && tauri build --debug",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check:style": "node scripts/check-style-leaks.mjs",
    "check": "pnpm typecheck && pnpm test:unit && pnpm check:style && pnpm check:rust",
    "check:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "pnpm sync-version && tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.9",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-toast": "1.2.23",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
