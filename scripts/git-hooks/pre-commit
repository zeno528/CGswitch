#!/bin/sh
# 提交前检查（硬闸门，由 git 执行，不分代码来源：人、Claude、其他 AI 都要过）。
# 按暂存内容分级，只跑能真正校验到本次改动的链：
#   - 暂存含 src-tauri/ → 全量 pnpm check（含 cargo fmt/clippy/测试，较慢）
#   - 暂存含前端代码或其配置（src/ scripts/ package.json lockfile tsconfig vite.config index.html）
#     → 前端链（样式 + i18n + typecheck + 单测，约 6 秒）
#   - 其余（纯文档/忽略规则/资源，如 README、.gitignore、docs/、归档/、public/、.github/）
#     → 检查链覆盖不到，直接放行
# 混合提交命中最重的一档；--no-verify 仍是逃生门。
# 本文件是正本（随仓库分发）；本机副本由 `pnpm hooks:sync` 安装到 .git/hooks/。
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

STAGED="$(git diff --cached --name-only)"
if [ -z "$STAGED" ]; then
  echo "[pre-commit] 暂存区为空，跳过检查"
  exit 0
fi

if echo "$STAGED" | grep -q '^src-tauri/'; then
  echo "[pre-commit] 检测到 src-tauri/ 改动 → 全量 pnpm check（含 Rust 链，请稍候）"
  pnpm check
elif echo "$STAGED" | grep -qE '^(src/|scripts/|package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|tsconfig\.|vite\.config\.|index\.html)'; then
  echo "[pre-commit] 检测到前端代码/配置改动 → 前端链：样式 + i18n + typecheck + 单测"
  node scripts/check-style-leaks.mjs
  node scripts/check-i18n-leaks.mjs
  npx tsc --noEmit
  npx vitest run
else
  echo "[pre-commit] 本次提交不含代码（纯文档/配置/资源），跳过检查链"
fi
echo "[pre-commit] 通过"
